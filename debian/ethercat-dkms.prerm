#!/bin/sh
set -e

NAME=ethercat
VERSION=$(dpkg-query -W -f='${Version}' "${DPKG_MAINTSCRIPT_PACKAGE:-ethercat-dkms}" 2>/dev/null | sed -e 's/^[0-9]*://' -e 's/-.*//')

case "$1" in
    remove|upgrade|deconfigure)
        if command -v dkms >/dev/null; then
            dkms remove -m ${NAME} -v ${VERSION} --all || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
