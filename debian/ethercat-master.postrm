#!/bin/sh
set -e

case "$1" in
    purge)
        if getent group ethercat >/dev/null; then
            delgroup --system --only-if-empty ethercat || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
